GITHUB_USERNAME=your_username
GITHUB_REPO_URL=https://github.com/organization/repo
GITHUB_REPO_URL_PERSONAL=https://github.com/username/repo
GITHUB_TOKEN=your_personal_access_token_here

# Optional chat. Keep the API key on the Node server.
PORT=5175
HOST=127.0.0.1
CHAT_ENABLED=false
CHAT_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
OPENAI_API_KEY=
CHAT_MODEL=
